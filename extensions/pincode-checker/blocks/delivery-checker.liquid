{% liquid
  assign block_id = block.id | replace: '-', ''
  assign heading_text = block.settings.heading
  if heading_text == blank
    assign heading_text = 'delivery_checker.heading' | t
  endif
  assign supporting_text = block.settings.supporting_text
  if supporting_text == blank
    assign supporting_text = 'delivery_checker.supporting_text' | t
  endif
  assign button_text = block.settings.button_text
  if button_text == blank
    assign button_text = 'delivery_checker.check_button' | t
  endif
  assign cod_enabled = block.settings.cod_enabled
  assign localization_country = localization.country.iso_code | default: 'US'
  assign selected_country = customer.default_address.country_code | default: localization_country
  assign saved_postal_code = customer.default_address.zip | default: ''
  assign product_id_value = ''
  assign product_vendor_value = ''
  assign product_tags_json = '[]'
  assign collection_handles_json = '[]'
  assign cart_items_json = '[]'
  assign context_product = product
  if context_product == blank and cart.item_count > 0
    assign context_product = cart.items.first.product
  endif
  if context_product
    assign product_id_value = context_product.id
    assign product_vendor_value = context_product.vendor
    assign product_tags_json = context_product.tags | json
    assign collection_handles_inner = ''
    for coll in context_product.collections
      assign handle_json = coll.handle | json
      if collection_handles_inner != ''
        assign collection_handles_inner = collection_handles_inner | append: ','
      endif
      assign collection_handles_inner = collection_handles_inner | append: handle_json
    endfor
    assign collection_handles_json = collection_handles_inner | prepend: '[' | append: ']'
  elsif collection
    assign collection_handle_json = collection.handle | json
    assign collection_handles_json = collection_handle_json | prepend: '[' | append: ']'
  endif
  if template.name == 'cart' and cart.item_count > 0
    capture cart_items_inner
      for item in cart.items limit: 20
        unless forloop.first
          echo ','
        endunless
        assign cart_variant_gid = item.variant_id | prepend: 'gid://shopify/ProductVariant/'
        assign cart_collections_inner = ''
        for coll in item.product.collections limit: 20
          assign cart_collection_json = coll.handle | json
          if cart_collections_inner != ''
            assign cart_collections_inner = cart_collections_inner | append: ','
          endif
          assign cart_collections_inner = cart_collections_inner | append: cart_collection_json
        endfor
        echo '{"productId":'
        echo item.product_id | json
        echo ',"variantId":'
        echo cart_variant_gid | json
        echo ',"quantity":'
        echo item.quantity | json
        echo ',"productVendor":'
        echo item.product.vendor | json
        echo ',"productTags":'
        echo item.product.tags | slice: 0, 20 | json
        echo ',"collectionHandles":['
        echo cart_collections_inner
        echo ']}'
      endfor
    endcapture
    assign cart_items_json = cart_items_inner | prepend: '[' | append: ']'
  endif
  assign checker_is_empty_cart = false
  if template.name == 'cart' and cart.item_count == 0
    assign checker_is_empty_cart = true
  endif
%}

{% if checker_is_empty_cart %}
  {% if request.design_mode %}
    <div class="pin-checker pin-checker--editor-empty-cart" {{ block.shopify_attributes }}>
      <div class="pin-checker__header">
        <span class="pin-checker__empty-icon" aria-hidden="true">📦</span>
        <div>
          <h3 class="pin-checker__heading">Delivery checker appears when the cart has items</h3>
          <p class="pin-checker__sub">Add a product to preview the live ZIP/PIN check, local delivery, pickup, and delivery estimate card.</p>
        </div>
      </div>
    </div>
    {{ 'delivery-checker.css' | asset_url | stylesheet_tag }}
    <style>
      .pin-checker--editor-empty-cart {
        max-width: 720px;
        margin: 18px auto;
        border: 1px solid rgba(17, 24, 39, .1);
        border-radius: 18px;
        padding: 18px;
        background: linear-gradient(135deg, #ffffff 0%, #f5fbff 100%);
        box-shadow: 0 16px 40px rgba(17, 24, 39, .08);
        color: #172033;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      .pin-checker--editor-empty-cart .pin-checker__empty-icon {
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        flex: 0 0 auto;
        border-radius: 14px;
        background: #e9f6ff;
        font-size: 21px;
      }
    </style>
  {% endif %}
{% else %}

<div
  class="pin-checker"
  id="pin-checker-{{ block_id }}"
  data-cod="{{ cod_enabled }}"
  data-auto-check-saved-address="{{ block.settings.auto_check_saved_address }}"
  data-localization-country="{{ localization_country | escape }}"
  data-saved-country="{{ selected_country | escape }}"
  data-saved-postal="{{ saved_postal_code | escape }}"
  data-show-countdown="{{ block.settings.show_cutoff_countdown }}"
  data-surface="{{ template.name | escape }}"
  data-show-journey="{{ block.settings.show_delivery_journey }}"
  data-line-style="dotted"
  data-template="modern-card"
  data-product-id="{{ product_id_value | escape }}"
  data-product-vendor="{{ product_vendor_value | escape }}"
  data-product-tags="{{ product_tags_json | escape }}"
  data-collection-handles="{{ collection_handles_json | escape }}"
  data-invalid-postal="{{ 'delivery_checker.invalid_postal' | t | escape }}"
  data-checking="{{ 'delivery_checker.checking' | t | escape }}"
  data-request-error="{{ 'delivery_checker.request_error' | t | escape }}"
  data-network-error="{{ 'delivery_checker.network_error' | t | escape }}"
  data-unlock-prompt="{{ 'delivery_checker.unlock_prompt' | t | escape }}"
  data-unlock-serviceable="{{ 'delivery_checker.unlock_serviceable' | t | escape }}"
  data-countdown-expired="{{ 'delivery_checker.countdown_expired' | t | escape }}"
  data-cod-label="{{ 'delivery_checker.cod' | t | escape }}"
  data-same-day-label="{{ 'delivery_checker.same_day' | t | escape }}"
  data-next-day-label="{{ 'delivery_checker.next_day' | t | escape }}"
  data-express-label="{{ 'delivery_checker.express' | t | escape }}"
  data-local-delivery-label="{{ 'delivery_checker.local_delivery' | t | escape }}"
  data-pickup-label="{{ 'delivery_checker.pickup' | t | escape }}"
  data-available-label="{{ 'delivery_checker.available' | t | escape }}"
  data-unavailable-label="{{ 'delivery_checker.unavailable' | t | escape }}"
  data-method-delivery-by="{{ 'delivery_checker.method_delivery_by' | t | escape }}"
  data-method-select-label="{{ 'delivery_checker.method_select_label' | t | escape }}"
  data-method-dispatch-label="{{ 'delivery_checker.method_dispatch_label' | t | escape }}"
  data-method-delivery-label="{{ 'delivery_checker.method_delivery_label' | t | escape }}"
  data-method-disclaimer="{{ 'delivery_checker.method_disclaimer' | t | escape }}"
  data-journey-today="{{ 'delivery_checker.journey_today' | t | escape }}"
  data-journey-preparing="{{ 'delivery_checker.journey_preparing' | t | escape }}"
  data-journey-calculating="{{ 'delivery_checker.journey_calculating' | t | escape }}"
  data-countdown-hours="{{ 'delivery_checker.countdown_hours' | t | escape }}"
  data-countdown-minutes="{{ 'delivery_checker.countdown_minutes' | t | escape }}"
  data-countdown-seconds="{{ 'delivery_checker.countdown_seconds' | t | escape }}"
  data-estimated-delivery-label="{{ 'delivery_checker.estimated_delivery_date' | t | escape }}"
  data-get-it-by-label="{{ 'delivery_checker.get_it_by' | t | escape }}"
  data-inline-delivery-checker
  {{ block.shopify_attributes }}
>
  <div class="pin-checker__header">
    <span class="pin-checker__mark" aria-hidden="true"></span>
    <div>
      <h3 class="pin-checker__heading">{{ heading_text | escape }}</h3>
      <p class="pin-checker__sub">{{ supporting_text | escape }}</p>
    </div>
  </div>
  <div class="pin-checker__row">
    <div class="pin-checker__country-wrap">
      <span class="pin-checker__country-flag" data-country-flag aria-hidden="true"></span>
      <label class="pin-checker__label" for="pin-country-{{ block_id }}">{{ 'delivery_checker.country_label' | t }}</label>
      <select
        class="pin-checker__select"
        name="country"
        aria-label="{{ 'delivery_checker.country_aria_label' | t | escape }}"
        id="pin-country-{{ block_id }}"
      >
        {% if localization.available_countries.size > 0 %}
          {% assign selected_country_available = false %}
          {% for country in localization.available_countries %}
            {% if country.iso_code == selected_country %}
              {% assign selected_country_available = true %}
            {% endif %}
            <option value="{{ country.iso_code | escape }}" {% if country.iso_code == selected_country %}selected{% endif %}>{{ country.name | escape }}</option>
          {% endfor %}
          {% unless selected_country_available %}
            <option value="{{ selected_country | escape }}" selected>{{ selected_country | escape }}</option>
          {% endunless %}
        {% else %}
          <option value="{{ selected_country | escape }}" selected>{{ selected_country | escape }}</option>
        {% endif %}
      </select>
    </div>
    <label class="pin-checker__label" for="pin-input-{{ block_id }}">{{ 'delivery_checker.postal_label' | t }}</label>
    <input
      class="pin-checker__input"
      type="text"
      name="postal_code"
      autocomplete="postal-code"
      inputmode="text"
      placeholder="{{ 'delivery_checker.postal_placeholder' | t | escape }}"
      aria-label="{{ 'delivery_checker.postal_aria_label' | t | escape }}"
      id="pin-input-{{ block_id }}"
      value="{{ saved_postal_code | escape }}"
    >
    <button class="pin-checker__button" type="button" id="pin-btn-{{ block_id }}">{{ button_text | escape }}</button>
  </div>
  {% if saved_postal_code != blank %}
    <div class="pin-checker__saved-location" data-saved-location>
      <span>{{ 'delivery_checker.saved_address_notice' | t }}</span>
      <button
        class="pin-checker__location-action"
        type="button"
        data-location-action
        data-change-label="{{ 'delivery_checker.change_location' | t | escape }}"
        data-restore-label="{{ 'delivery_checker.use_saved_address' | t | escape }}"
      >{{ 'delivery_checker.change_location' | t }}</button>
    </div>
  {% endif %}
  <p class="pin-checker__result" id="pin-result-{{ block_id }}" aria-live="polite" aria-atomic="true"></p>
  <script type="application/json" id="pin-cart-items-{{ block_id }}">{{ cart_items_json }}</script>
  <div class="pin-checker__details" id="pin-details-{{ block_id }}" hidden>
    <div class="pin-checker__journey" id="pin-journey-{{ block_id }}" hidden aria-label="{{ 'delivery_checker.journey_aria_label' | t | escape }}">
      <div class="pin-checker__journey-title">
        <span data-country-flag aria-hidden="true"></span>
        <span>{{ 'delivery_checker.estimated_delivery_date' | t }}</span>
        <strong data-journey-range></strong>
      </div>
      <div class="pin-checker__journey-step pin-checker__journey-step--active">
        <span class="pin-checker__journey-marker">
          <span class="pin-checker__journey-number">1</span>
          <svg class="pin-checker__journey-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="19" r="1.5"></circle><circle cx="18" cy="19" r="1.5"></circle>
            <path d="M3 4h2l2.4 10.1a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L21 8H7"></path>
          </svg>
        </span>
        <strong>{{ 'delivery_checker.journey_order_now' | t }}</strong>
        <small data-journey-order></small>
      </div>
      <div class="pin-checker__journey-step">
        <span class="pin-checker__journey-marker">
          <span class="pin-checker__journey-number">2</span>
          <svg class="pin-checker__journey-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m4 7 8-4 8 4-8 4-8-4Z"></path><path d="M4 7v10l8 4 8-4V7M12 11v10M8 5l8 4"></path>
          </svg>
        </span>
        <strong>{{ 'delivery_checker.journey_ready_to_ship' | t }}</strong>
        <small data-journey-dispatch></small>
      </div>
      <div class="pin-checker__journey-step">
        <span class="pin-checker__journey-marker">
          <span class="pin-checker__journey-number">3</span>
          <svg class="pin-checker__journey-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m3 11 9-8 9 8"></path><path d="M5.5 9.5V21h13V9.5M9 21v-7h6v7M16 6V3h2v5"></path>
          </svg>
        </span>
        <strong>{{ 'delivery_checker.journey_at_doorstep' | t }}</strong>
        <small data-journey-delivery></small>
      </div>
    </div>
    <section class="pin-checker__countdown" id="pin-countdown-{{ block_id }}" hidden aria-live="polite">
      <span class="pin-checker__countdown-title" data-countdown-title>🔥 {{ 'delivery_checker.countdown_title' | t }} 🔥</span>
      <span class="pin-checker__countdown-label" id="pin-countdown-label-{{ block_id }}">{{ 'delivery_checker.order_within' | t }}</span>
      <strong id="pin-countdown-value-{{ block_id }}"></strong>
      <span class="pin-checker__countdown-delivery" data-countdown-delivery></span>
    </section>
    <ul
      class="pin-checker__options"
      id="pin-options-{{ block_id }}"
      aria-label="{{ 'delivery_checker.shipping_options' | t | escape }}"
      hidden
    ></ul>
    <div class="pin-checker__methods" id="pin-methods-{{ block_id }}" hidden>
      <div id="pin-method-controls-{{ block_id }}"></div>
      <p class="pin-checker__method-summary" id="pin-method-summary-{{ block_id }}" aria-live="polite"></p>
      <p class="pin-checker__method-disclaimer">{{ 'delivery_checker.method_disclaimer' | t }}</p>
    </div>
  </div>
</div>

{{ 'delivery-checker.css' | asset_url | stylesheet_tag }}
<style>
  #pin-checker-{{ block_id }} {
    --pc-border: rgba(17, 24, 39, 0.12);
    --pc-heading: {{ block.settings.text_color | default: '#16151a' }};
    --pc-sub: #62636a;
    --pc-input-border: rgba(17, 24, 39, 0.2);
    --pc-focus: {{ block.settings.button_color | default: '#2b2640' }};
    --pc-btn: {{ block.settings.button_color | default: '#2b2640' }};
    --pc-btn-text: {{ block.settings.button_text_color | default: '#ffffff' }};
    --pc-card: {{ block.settings.background_color | default: '#ffffff' }};
    --pc-field-bg: #ffffff;
    --pc-result-bg: #171717;
    --pc-result-text: #ffffff;
    --pc-countdown-bg: #06451f;
    --pc-countdown-digit: #ff6500;
    --pc-countdown-text: #ffffff;
    --pc-radius: {{ block.settings.corner_radius | default: 14 }}px;
    --pc-font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --pc-font-size: 14px;
    --pc-heading-size: 18px;
    --pc-journey-bg: {{ block.settings.journey_background_color | default: '#e6edff' }};
    --pc-journey-active: {{ block.settings.journey_active_color | default: '#9bb8f2' }};
    --pc-journey-line: #f28c52;
    border: 1px solid var(--pc-border);
    border-radius: var(--pc-radius);
    padding: 18px;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--pc-journey-bg) 58%, transparent), transparent 38%),
      var(--pc-card);
    box-shadow: 0 18px 46px rgba(17, 24, 39, 0.1);
    color: var(--pc-heading);
    font-family: var(--pc-font);
    font-size: var(--pc-font-size);
  }
</style>

<script>
  (() => {
    const root = document.getElementById('pin-checker-{{ block_id }}');
    if (!root || root.dataset.pincodeInitialized === 'true') return;
    root.dataset.pincodeInitialized = 'true';

    const countrySelect = document.getElementById('pin-country-{{ block_id }}');
    const pinInput = document.getElementById('pin-input-{{ block_id }}');
    const button = document.getElementById('pin-btn-{{ block_id }}');
    const result = document.getElementById('pin-result-{{ block_id }}');
    const details = document.getElementById('pin-details-{{ block_id }}');
    const journey = document.getElementById('pin-journey-{{ block_id }}');
    const journeyOrder = journey && journey.querySelector('[data-journey-order]');
    const journeyDispatch = journey && journey.querySelector('[data-journey-dispatch]');
    const journeyDelivery = journey && journey.querySelector('[data-journey-delivery]');
    const countdown = document.getElementById('pin-countdown-{{ block_id }}');
    const countdownLabel = document.getElementById('pin-countdown-label-{{ block_id }}');
    const countdownValue = document.getElementById('pin-countdown-value-{{ block_id }}');
    const options = document.getElementById('pin-options-{{ block_id }}');
    const methods = document.getElementById('pin-methods-{{ block_id }}');
    const methodControls = document.getElementById('pin-method-controls-{{ block_id }}');
    const methodSummary = document.getElementById('pin-method-summary-{{ block_id }}');
    const cod = root.dataset.cod === 'true';
    const savedLocation = root.querySelector('[data-saved-location]');
    const locationAction = root.querySelector('[data-location-action]');
    const savedCountry = String(root.dataset.savedCountry || '').trim();
    const savedPostal = String(root.dataset.savedPostal || '').trim();
    const localizationCountry = String(root.dataset.localizationCountry || 'US').trim();
    const cartItemsElement = document.getElementById('pin-cart-items-{{ block_id }}');
    const hasProduct = Boolean(String(root.dataset.productId || '').trim());
    const productScope = root.closest('.shopify-section, [data-section]') || document;
    const eventController = new AbortController();
    const eventOptions = { signal: eventController.signal };

    let requireValidPin = false;
    let pinUnlocked = false;
    let shopDisableAtc = false;
    let addToCartDisabled = false;
    let activeController = null;
    let requestVersion = 0;
    let countdownTimer = null;
    let cartAttributeWrite = Promise.resolve();
    let estimateInvalidated = false;

    const parseJsonArray = (value) => {
      try {
        const parsed = JSON.parse(value || '[]');
        return Array.isArray(parsed) ? parsed.map(String) : [];
      } catch (error) {
        return [];
      }
    };

    const applyStorefrontStyle = (style) => {
      if (!style || typeof style !== 'object') return;
      const fonts = {
        system: "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        inter: "Inter, system-ui, sans-serif",
        poppins: "Poppins, system-ui, sans-serif",
        'dm-sans': "'DM Sans', system-ui, sans-serif",
        jakarta: "'Plus Jakarta Sans', system-ui, sans-serif"
      };
      const setColor = (name, value) => {
        if (typeof value === 'string' && /^#[0-9a-f]{6}$/i.test(value)) root.style.setProperty(name, value);
      };
      if (fonts[style.font_family]) root.style.setProperty('--pc-font', fonts[style.font_family]);
      if (Number.isFinite(Number(style.font_size))) root.style.setProperty('--pc-font-size', `${Number(style.font_size)}px`);
      if (Number.isFinite(Number(style.heading_size))) root.style.setProperty('--pc-heading-size', `${Number(style.heading_size)}px`);
      if (Number.isFinite(Number(style.border_radius))) root.style.setProperty('--pc-radius', `${Number(style.border_radius)}px`);
      setColor('--pc-heading', style.text_color);
      setColor('--pc-sub', style.muted_color);
      setColor('--pc-focus', style.accent_color);
      setColor('--pc-btn', style.button_color);
      setColor('--pc-btn-text', style.button_text_color);
      setColor('--pc-card', style.card_background);
      setColor('--pc-field-bg', style.field_background);
      setColor('--pc-input-border', style.field_border_color);
      setColor('--pc-result-bg', style.result_background);
      setColor('--pc-result-text', style.result_text_color);
      setColor('--pc-journey-bg', style.journey_background);
      setColor('--pc-journey-active', style.journey_active_color);
      setColor('--pc-journey-line', style.journey_line_color);
      setColor('--pc-countdown-bg', style.countdown_background);
      setColor('--pc-countdown-digit', style.countdown_digit_color);
      setColor('--pc-countdown-text', style.countdown_text_color);
      const countdownTitle = root.querySelector('[data-countdown-title]');
      if (countdownTitle && typeof style.countdown_title === 'string' && style.countdown_title.trim()) {
        countdownTitle.textContent = `🔥 ${style.countdown_title.trim()} 🔥`;
      }
      root.dataset.iconStyle = String(style.icon_style || root.dataset.iconStyle || 'number');
      root.dataset.animation = String(style.animation || 'soft');
      root.dataset.lineStyle = String(style.journey_line_style || 'dotted');
      root.dataset.template = String(style.template || 'modern-card');
      root.dataset.showJourney = String(style.show_journey !== false);
      if (typeof style.custom_css === 'string' && style.custom_css.length <= 5000 && !/@import|url\s*\(|expression\s*\(|javascript:|<\/?(?:script|style)/i.test(style.custom_css)) {
        let customStyle = document.getElementById('incode-storefront-custom-css');
        if (!customStyle) {
          customStyle = document.createElement('style');
          customStyle.id = 'incode-storefront-custom-css';
          document.head.appendChild(customStyle);
        }
        customStyle.textContent = style.custom_css;
      }
    };

    const productContextParams = () => {
      const params = new URLSearchParams();
      params.set('surface', String(root.dataset.surface || 'product'));
      if (countrySelect && countrySelect.value) params.set('country', countrySelect.value);
      const productId = String(root.dataset.productId || '').trim();
      if (productId) params.set('productId', productId);
      const productVendor = String(root.dataset.productVendor || '').trim();
      if (productVendor) params.set('productVendor', productVendor);
      const tags = parseJsonArray(root.dataset.productTags);
      if (tags.length) params.set('productTags', tags.join('|'));
      const collections = parseJsonArray(root.dataset.collectionHandles);
      if (collections.length) params.set('collections', collections.join('|'));
      const variantId = getSelectedVariantId();
      if (variantId) params.set('variantId', variantId);
      try {
        const cartItems = JSON.parse(cartItemsElement ? cartItemsElement.textContent : '[]');
        if (Array.isArray(cartItems) && cartItems.length) params.set('cartItems', JSON.stringify(cartItems));
      } catch (error) {
        // Invalid cart context falls back to the current product or shop-wide estimate.
      }
      return params;
    };

    const getAddToCartButtons = () => hasProduct ? Array.from(productScope.querySelectorAll([
      'form[action*="/cart/add"] button[type="submit"]',
      'form[data-type="add-to-cart-form"] button[type="submit"]',
      'button[name="add"]',
      '.product-form__submit'
    ].join(','))) : [];

    const setAddToCartDisabled = (disabled) => {
      addToCartDisabled = disabled;
      getAddToCartButtons().forEach((submitButton) => {
        if (disabled) {
          submitButton.dataset.pincodeAtcDisabled = 'true';
          if (!submitButton.hasAttribute('aria-disabled')) {
            submitButton.dataset.pincodeAriaOwned = 'true';
            submitButton.setAttribute('aria-disabled', 'true');
          }
          return;
        }
        delete submitButton.dataset.pincodeAtcDisabled;
        if (submitButton.dataset.pincodeAriaOwned === 'true') {
          if (submitButton.getAttribute('aria-disabled') === 'true') {
            submitButton.removeAttribute('aria-disabled');
          }
          delete submitButton.dataset.pincodeAriaOwned;
        }
      });
    };

    const toVariantGid = (value) => {
      const raw = String(value || '').trim();
      if (!raw) return '';
      if (raw.indexOf('gid://shopify/ProductVariant/') === 0) {
        return raw;
      }
      const numeric = raw.replace(/\D/g, '');
      return numeric ? `gid://shopify/ProductVariant/${numeric}` : '';
    };

    const getSelectedVariantId = () => {
      if (!hasProduct) return '';
      const search = [
        'form[action*="/cart/add"] [name="id"]',
        'form[action*="/cart/add"] [name="variant"]',
        'form[data-type="add-to-cart-form"] [name="id"]',
        'input[name="id"]',
        'select[name="id"]',
        '[name="id"][type="hidden"]',
        '[data-variant-id]'
      ];

      for (const selector of search) {
        const el = productScope.querySelector(selector);
        if (!el) continue;
        const value = el.value || (el.dataset && el.dataset.variantId) || '';
        const gid = toVariantGid(value);
        if (gid) return gid;
      }

      const fromUrl = new URLSearchParams(window.location.search).get('variant');
      return toVariantGid(fromUrl);
    };

    const getQuantity = () => {
      if (!hasProduct) return 1;
      const quantityInput = productScope.querySelector('form[action*="/cart/add"] [name="quantity"], form[data-type="add-to-cart-form"] [name="quantity"], input[name="quantity"]');
      const parsed = Number(quantityInput && quantityInput.value ? quantityInput.value : '1');
      return Number.isFinite(parsed) && parsed > 0 ? Math.floor(parsed) : 1;
    };

    const setResult = (message, state) => {
      result.textContent = message;
      result.setAttribute('data-state', state || '');
      result.setAttribute('role', state === 'error' ? 'alert' : 'status');
      root.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');
    };

    const clearDetails = () => {
      if (countdownTimer) window.clearInterval(countdownTimer);
      countdownTimer = null;
      if (journey) journey.hidden = true;
      countdown.hidden = true;
      options.hidden = true;
      options.replaceChildren();
      methods.hidden = true;
      methodControls.replaceChildren();
      methodSummary.textContent = '';
      details.hidden = true;
    };

    const formatJourneyDate = (value) => {
      if (!value) return '';
      const parsed = new Date(`${String(value).slice(0, 10)}T12:00:00`);
      if (Number.isNaN(parsed.getTime())) return String(value);
      return new Intl.DateTimeFormat(undefined, { day: '2-digit', month: 'short' }).format(parsed);
    };

    const countryFlag = (value) => {
      const code = String(value || '').trim().toUpperCase();
      return /^[A-Z]{2}$/.test(code)
        ? String.fromCodePoint(...[...code].map((character) => 127397 + character.charCodeAt(0)))
        : '';
    };

    const updateCountryFlags = () => {
      const flag = countryFlag(countrySelect && countrySelect.value);
      root.querySelectorAll('[data-country-flag]').forEach((element) => { element.textContent = flag; });
    };

    const renderJourney = (data) => {
      if (!journey || root.dataset.showJourney !== 'true' || !data || data.available !== true) return;
      if (journeyOrder) journeyOrder.textContent = root.dataset.journeyToday;
      if (journeyDispatch) journeyDispatch.textContent = data.dispatch_date_label || formatJourneyDate(data.dispatch_date) || root.dataset.journeyPreparing;
      if (journeyDelivery) {
        const earliest = data.estimated_date_label || formatJourneyDate(data.estimated_date);
        const latest = data.estimated_date_max_label || formatJourneyDate(data.estimated_date_max);
        journeyDelivery.textContent = earliest && latest && earliest !== latest
          ? `${earliest} - ${latest}`
          : earliest || latest || root.dataset.journeyCalculating;
      }
      const journeyRange = journey.querySelector('[data-journey-range]');
      if (journeyRange) journeyRange.textContent = data.delivery_date_range || data.estimated_date_max_label || data.estimated_date_label || '';
      updateCountryFlags();
      journey.hidden = false;
    };

      const renderShippingOptions = (data) => {
      const optionFields = [
        ['cod_available', root.dataset.codLabel],
        ['same_day_available', root.dataset.sameDayLabel],
        ['next_day_available', root.dataset.nextDayLabel],
        ['express_available', root.dataset.expressLabel],
        ['local_delivery_available', root.dataset.localDeliveryLabel],
        ['pickup_available', root.dataset.pickupLabel]
      ];
      const fragment = document.createDocumentFragment();

      optionFields.forEach(([field, label]) => {
        if (typeof data[field] !== 'boolean') return;
        const item = document.createElement('li');
        const mark = document.createElement('span');
        const copy = document.createElement('span');
        const state = document.createElement('strong');
        const available = data[field];
        const iconStyle = ['number', 'delivery', 'duotone', 'circle', 'minimal', 'emoji'].includes(root.dataset.iconStyle)
          ? root.dataset.iconStyle
          : 'number';
        const serviceKind = field === 'local_delivery_available' ? 'local' : field === 'pickup_available' ? 'pickup' : 'standard';
        item.className = 'pin-checker__option';
        item.dataset.available = String(available);
        item.dataset.iconStyle = iconStyle;
        item.dataset.animation = String(root.dataset.animation || 'none');
        item.dataset.serviceKind = serviceKind;
        item.setAttribute('aria-label', `${label}: ${available ? root.dataset.availableLabel : root.dataset.unavailableLabel}`);
        mark.className = 'pin-checker__option-mark';
        mark.setAttribute('aria-hidden', 'true');
        mark.dataset.serviceKind = serviceKind;
        if (iconStyle === 'emoji') {
          mark.textContent = serviceKind === 'local' ? '🚚' : serviceKind === 'pickup' ? '🏪' : available ? '✓' : '×';
        } else if (iconStyle === 'minimal') {
          mark.textContent = '';
        } else if (iconStyle === 'circle') {
          mark.textContent = available ? '✓' : '×';
        } else if (iconStyle === 'delivery' || iconStyle === 'duotone') {
          mark.textContent = '';
        } else {
          mark.textContent = available ? '\u2713' : '\u00d7';
        }
        copy.className = 'pin-checker__option-copy';
        copy.textContent = label;
        state.className = 'pin-checker__option-state';
        state.textContent = available ? root.dataset.availableLabel : root.dataset.unavailableLabel;
        item.append(mark, copy, state);
        fragment.append(item);
      });

      options.replaceChildren(fragment);
      options.hidden = options.childElementCount === 0;
    };

    const renderMethodSelection = (data) => {
      const shippingMethods = Array.isArray(data.shipping_methods)
        ? data.shipping_methods.filter((method) => method && method.handle && method.name && method.estimated_date)
        : [];
      if (!shippingMethods.length) return;

      const selectMethod = (method) => {
        const dispatchLabel = method.dispatch_date_label || formatJourneyDate(method.dispatch_date) || method.dispatch_date;
        const deliveryLabel = method.estimated_date_label || formatJourneyDate(method.estimated_date) || method.estimated_date;
        const estimateSummary = `${method.name}. ${root.dataset.methodDispatchLabel}: ${dispatchLabel}. ${root.dataset.methodDeliveryLabel}: ${deliveryLabel}.`;
        const selectedData = {
          ...data,
          dispatch_date: method.dispatch_date,
          dispatch_date_label: dispatchLabel,
          estimated_date: method.estimated_date,
          estimated_date_label: deliveryLabel,
          estimated_date_max: method.estimated_date,
          estimated_date_max_label: deliveryLabel,
          processing_days: method.processing_days,
          transit_days: method.transit_days,
          message: method.custom_message || estimateSummary
        };
        renderJourney(selectedData);
        methodSummary.textContent = method.custom_message
          ? `${method.custom_message} ${estimateSummary}`
          : estimateSummary;
        setResult(selectedData.message, 'success');
        void persistEstimate(selectedData, data.country, data.postal_code).catch(() => {});
      };

      const displayStyle = data.shipping_method_display_style
        || (data.storefront_style && data.storefront_style.shipping_method_display_style)
        || 'visual';
      if (displayStyle === 'dropdown') {
        const label = document.createElement('label');
        const select = document.createElement('select');
        const placeholder = document.createElement('option');
        label.className = 'pin-checker__method-label';
        label.htmlFor = 'pin-method-select-{{ block_id }}';
        label.textContent = root.dataset.methodSelectLabel;
        select.className = 'pin-checker__method-select';
        select.id = 'pin-method-select-{{ block_id }}';
        placeholder.value = '';
        placeholder.textContent = root.dataset.methodSelectLabel;
        placeholder.disabled = true;
        placeholder.selected = true;
        select.append(placeholder);
        shippingMethods.forEach((method) => {
          const option = document.createElement('option');
          option.value = method.handle;
          option.textContent = `${method.name} - ${root.dataset.methodDeliveryBy} ${method.estimated_date_label || method.estimated_date}`;
          select.append(option);
        });
        select.addEventListener('change', () => {
          const selected = shippingMethods.find((method) => method.handle === select.value);
          if (selected) selectMethod(selected);
        }, eventOptions);
        methodControls.append(label, select);
      } else {
        const fieldset = document.createElement('fieldset');
        const legend = document.createElement('legend');
        fieldset.className = 'pin-checker__method-fieldset';
        legend.className = 'pin-checker__method-legend';
        legend.textContent = root.dataset.methodSelectLabel;
        fieldset.append(legend);
        shippingMethods.forEach((method) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          const name = document.createElement('strong');
          const description = document.createElement('span');
          const dates = document.createElement('span');
          label.className = 'pin-checker__method-card';
          input.type = 'radio';
          input.name = 'pin-shipping-method-{{ block_id }}';
          input.value = method.handle;
          name.textContent = method.name;
          description.className = 'pin-checker__method-copy';
          description.textContent = method.description || '';
          dates.className = 'pin-checker__method-dates';
          dates.textContent = `${root.dataset.methodDispatchLabel}: ${method.dispatch_date_label || method.dispatch_date}. ${root.dataset.methodDeliveryLabel}: ${method.estimated_date_label || method.estimated_date}.`;
          input.addEventListener('change', () => selectMethod(method), eventOptions);
          label.append(input, name);
          if (description.textContent) label.append(description);
          label.append(dates);
          fieldset.append(label);
        });
        methodControls.append(fieldset);
      }
      methods.hidden = false;
    };

    const renderCountdown = (data) => {
      if (root.dataset.showCountdown !== 'true' || root.dataset.countdownVisible === 'false') return;
      const secondsRemaining = Number(data.seconds_until_cutoff ?? data.cutoff_seconds_remaining);
      const rawCutoff = data.cutoff_at || data.delivery_cutoff_at || data.cutoff_timestamp || data.delivery_cutoff || data.cutoff_time || data.cutoffAt || data.deliveryCutoffAt;
      let cutoffTime = Number.isFinite(secondsRemaining) && secondsRemaining > 0
        ? Date.now() + (secondsRemaining * 1000)
        : NaN;
      if (!Number.isFinite(cutoffTime) && (typeof rawCutoff === 'string' || typeof rawCutoff === 'number')) {
        const normalizedCutoff = typeof rawCutoff === 'number' && rawCutoff < 1000000000000
          ? rawCutoff * 1000
          : rawCutoff;
        cutoffTime = new Date(normalizedCutoff).getTime();
      }
      if (!Number.isFinite(cutoffTime)) return;

      const updateCountdown = () => {
        const remaining = Math.max(0, Math.floor((cutoffTime - Date.now()) / 1000));
        if (remaining === 0) {
          countdownLabel.hidden = true;
          countdownValue.textContent = root.dataset.countdownExpired;
          window.clearInterval(countdownTimer);
          countdownTimer = null;
          return;
        }
        const hours = Math.floor(remaining / 3600);
        const minutes = Math.floor((remaining % 3600) / 60);
        const seconds = remaining % 60;
        countdownValue.innerHTML = [
          [hours, root.dataset.countdownHours],
          [minutes, root.dataset.countdownMinutes],
          [seconds, root.dataset.countdownSeconds]
        ].map(([part, label]) => `<span><b>${String(part).padStart(2, '0')}</b><small>${label}</small></span>`).join('');
      };

      countdownLabel.hidden = false;
      const countdownDelivery = countdown.querySelector('[data-countdown-delivery]');
      if (countdownDelivery) {
        const range = data.delivery_date_range || data.estimated_date_max_label || data.estimated_date_label || '';
        countdownDelivery.textContent = range ? `${root.dataset.getItByLabel} ${range}` : '';
      }
      countdown.hidden = false;
      updateCountdown();
      if (cutoffTime > Date.now()) countdownTimer = window.setInterval(updateCountdown, 1000);
    };

    const renderDetails = (data) => {
      clearDetails();
      if (!data || data.available !== true) return;
      root.dataset.countdownVisible = String(data.countdown_visible !== false);
      renderJourney(data);
      renderShippingOptions(data);
      renderMethodSelection(data);
      renderCountdown(data);
      details.hidden = options.hidden && methods.hidden && countdown.hidden && journey.hidden;
    };

    const estimateAttributeKeys = [
      '_incode_estimated_date',
      '_incode_estimated_date_max',
      '_incode_estimated_date_label',
      '_incode_estimated_date_max_label',
      '_incode_delivery_date_range',
      '_incode_dispatch_date',
      '_incode_postal_code',
      '_incode_country',
      '_incode_eta_message'
    ];

    const updateCartAttributes = (attributes) => {
      const write = async () => {
        const response = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          keepalive: true,
          body: JSON.stringify({ attributes })
        });
        if (!response.ok) throw new Error('Unable to update delivery estimate attributes');
      };
      cartAttributeWrite = cartAttributeWrite.catch(() => {}).then(write);
      return cartAttributeWrite;
    };

    const clearPersistedEstimate = () => {
      if (estimateInvalidated) return cartAttributeWrite;
      estimateInvalidated = true;
      return updateCartAttributes(
        Object.fromEntries(estimateAttributeKeys.map((key) => [key, '']))
      ).catch((error) => {
        estimateInvalidated = false;
        throw error;
      });
    };

    const persistEstimate = (data, country, postalCode) => {
      if (!data || data.available !== true || !data.estimated_date) return clearPersistedEstimate();
      estimateInvalidated = false;
      const attributes = {
        '_incode_estimated_date': String(data.estimated_date),
        '_incode_estimated_date_max': String(data.estimated_date_max || data.estimated_date),
        '_incode_estimated_date_label': String(data.estimated_date_label || data.estimated_date),
        '_incode_estimated_date_max_label': String(data.estimated_date_max_label || data.estimated_date_label || data.estimated_date_max || data.estimated_date),
        '_incode_delivery_date_range': String(data.delivery_date_range || data.estimated_date_max_label || data.estimated_date_label || data.estimated_date),
        '_incode_dispatch_date': String(data.dispatch_date || ''),
        '_incode_postal_code': String(data.postal_code || postalCode || ''),
        '_incode_country': String(data.country || country || ''),
        '_incode_eta_message': String(data.message || '').slice(0, 500)
      };
      return updateCartAttributes(attributes);
    };

    const patterns = {
      AU: /^\d{4}$/,
      CA: /^[A-Z]\d[A-Z]\s?\d[A-Z]\d$/,
      DE: /^\d{5}$/,
      ES: /^\d{5}$/,
      FR: /^\d{5}$/,
      GB: /^[A-Z]{1,2}\d[A-Z\d]?\s?\d[A-Z]{2}$/,
      IN: /^[1-9][0-9]{5}$/,
      IT: /^\d{5}$/,
      JP: /^\d{3}-?\d{4}$/,
      NL: /^\d{4}\s?[A-Z]{2}$/,
      NZ: /^\d{4}$/,
      US: /^\d{5}(-?\d{4})?$/
    };

    const normalizeCountry = (country) => /^[A-Z]{2}$/.test(country || '') ? country : 'US';

    const normalizePostalCode = (country, value) => {
      const code = String(value || '').trim().toUpperCase().replace(/\s+/g, ' ');
      if (['IN', 'AU', 'DE', 'ES', 'FR', 'IT', 'NZ'].includes(country)) return code.replace(/\D/g, '');
      if (country === 'US' || country === 'JP') return code.replace(/\s+/g, '');
      return code;
    };

    const validate = (country, code) => {
      const pattern = patterns[country];
      if (pattern) return pattern.test(code);
      return /^[A-Z0-9][A-Z0-9 -]{1,18}[A-Z0-9]$/.test(code);
    };

    const applyAddToCartPolicy = (available) => {
      if (requireValidPin && !pinUnlocked) {
        setAddToCartDisabled(true);
        return;
      }
      if (shopDisableAtc && available === false) {
        setAddToCartDisabled(true);
        return;
      }
      if (available === undefined || available === null) {
        setAddToCartDisabled(requireValidPin && !pinUnlocked);
        return;
      }
      setAddToCartDisabled(false);
    };

    const applyPolicyFrom = (data) => {
      if (data && data.enabled === false) {
        requireValidPin = false;
        shopDisableAtc = false;
        pinUnlocked = true;
        setAddToCartDisabled(false);
        root.hidden = true;
        return;
      }
      if (data && typeof data.require_valid_pin === 'boolean') {
        requireValidPin = data.require_valid_pin;
      }
      if (data && typeof data.disable_add_to_cart === 'boolean') {
        shopDisableAtc = data.disable_add_to_cart;
      }
      if (typeof data !== 'object' || data === null) return;
      if (data.available === true) {
        pinUnlocked = true;
      } else {
        pinUnlocked = false;
      }
    };

    const initPolicy = async () => {
      try {
        const query = productContextParams();
        query.set('init', '1');
        const response = await fetch(`/apps/delivery-checker?${query.toString()}`, {
          method: 'GET',
          headers: { Accept: 'application/json' }
        });
        if (!response.ok) return;
        const data = await response.json();
        applyStorefrontStyle(data.storefront_style);
        applyPolicyFrom(data);
        if (data.enabled === false) {
          await clearPersistedEstimate().catch(() => {});
          return;
        }
        if (requireValidPin && !pinUnlocked) {
          setAddToCartDisabled(true);
          if (!result.textContent) {
            setResult(data.message || root.dataset.unlockPrompt, 'error');
          }
        } else {
          applyAddToCartPolicy(undefined);
        }
      } catch (error) {
        // Keep the widget usable if the policy request fails.
      }
    };

    const runCheck = async () => {
      requestVersion += 1;
      const currentVersion = requestVersion;
      if (activeController) activeController.abort();
      activeController = new AbortController();
      const country = normalizeCountry(countrySelect && countrySelect.value);
      const pin = normalizePostalCode(country, pinInput.value || '');
      pinInput.value = pin;

      if (!validate(country, pin)) {
        clearDetails();
        void clearPersistedEstimate().catch(() => {});
        setResult(root.dataset.invalidPostal, 'error');
        pinUnlocked = false;
        applyAddToCartPolicy(undefined);
        return;
      }

      clearDetails();
      void clearPersistedEstimate().catch(() => {});
      setResult(root.dataset.checking, 'loading');
      button.disabled = true;

      try {
        const query = productContextParams();
        query.set('country', country);
        query.set('postal_code', pin);
        query.set('cod', cod ? '1' : '0');
        query.set('qty', String(getQuantity()));

        const response = await fetch(`/apps/delivery-checker?${query.toString()}`, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          signal: activeController.signal
        });

        const data = await response.json();
        if (currentVersion !== requestVersion) return;
        applyStorefrontStyle(data.storefront_style);
        if (!response.ok) {
          await clearPersistedEstimate().catch(() => {});
          if (currentVersion !== requestVersion) return;
          setResult(root.dataset.requestError, 'error');
          applyAddToCartPolicy(undefined);
          return;
        }

        applyPolicyFrom(data);
        if (data.enabled === false) {
          await clearPersistedEstimate().catch(() => {});
          return;
        }
        setResult(data.message || root.dataset.requestError, data.available ? 'success' : 'error');
        renderDetails(data);
        await persistEstimate(data, country, pin).catch(() => {});
        if (currentVersion !== requestVersion) return;
        if (requireValidPin && data.available) {
          pinUnlocked = true;
        } else if (requireValidPin && !data.available) {
          pinUnlocked = false;
        }
        applyAddToCartPolicy(data.available);
        if (requireValidPin && !pinUnlocked && data.available === false) {
          setResult(
            data.message || root.dataset.unlockServiceable,
            'error'
          );
        }
      } catch (error) {
        if (error && error.name === 'AbortError') return;
        if (currentVersion !== requestVersion) return;
        clearDetails();
        await clearPersistedEstimate().catch(() => {});
        if (currentVersion !== requestVersion) return;
        setResult(root.dataset.networkError, 'error');
        applyAddToCartPolicy(undefined);
      } finally {
        if (currentVersion === requestVersion) {
          button.disabled = false;
          activeController = null;
        }
      }
    };

    button.addEventListener('click', runCheck, eventOptions);
    const clearStaleResult = () => {
      requestVersion += 1;
      if (activeController) {
        activeController.abort();
        activeController = null;
      }
      button.disabled = false;
      result.textContent = '';
      result.removeAttribute('data-state');
      root.setAttribute('aria-busy', 'false');
      clearDetails();
      void clearPersistedEstimate().catch(() => {});
      if (requireValidPin) {
        pinUnlocked = false;
        setAddToCartDisabled(true);
        setResult(root.dataset.unlockPrompt, 'error');
      } else {
        applyAddToCartPolicy(undefined);
      }
    };
    const setSavedLocationActive = (active) => {
      root.dataset.savedLocationActive = String(active);
      if (savedLocation) savedLocation.querySelector('span').hidden = !active;
      if (locationAction) {
        locationAction.textContent = active
          ? locationAction.dataset.changeLabel
          : locationAction.dataset.restoreLabel;
      }
    };
    countrySelect.addEventListener('change', () => {
      updateCountryFlags();
      clearStaleResult();
      setSavedLocationActive(false);
    }, eventOptions);
    pinInput.addEventListener('input', () => {
      clearStaleResult();
      setSavedLocationActive(false);
    }, eventOptions);
    if (locationAction) {
      locationAction.addEventListener('click', () => {
        const restore = root.dataset.savedLocationActive !== 'true';
        clearStaleResult();
        if (restore) {
          if (savedCountry) countrySelect.value = savedCountry;
          updateCountryFlags();
          pinInput.value = savedPostal;
          setSavedLocationActive(true);
          pinInput.focus();
          return;
        }
        countrySelect.value = localizationCountry;
        updateCountryFlags();
        pinInput.value = '';
        setSavedLocationActive(false);
        pinInput.focus();
      }, eventOptions);
    }
    productScope.addEventListener('change', (event) => {
      if (hasProduct && event.target && event.target.matches('[name="id"], [name="variant"], [name="quantity"]')) {
        clearStaleResult();
      }
    }, eventOptions);
    productScope.addEventListener('input', (event) => {
      if (hasProduct && event.target && event.target.matches('[name="quantity"]')) {
        clearStaleResult();
      }
    }, eventOptions);
    pinInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        runCheck();
      }
    }, eventOptions);

    productScope.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-pincode-atc-disabled="true"]') : null;
      if (!target) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, { capture: true, signal: eventController.signal });
    productScope.addEventListener('submit', (event) => {
      if (!(event.target instanceof Element) || !event.target.querySelector('[data-pincode-atc-disabled="true"]')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
    }, { capture: true, signal: eventController.signal });

    const buttonObserver = new MutationObserver(() => {
      if (addToCartDisabled) setAddToCartDisabled(true);
    });
    if (hasProduct) buttonObserver.observe(productScope, { childList: true, subtree: true });

    const cleanup = () => {
      requestVersion += 1;
      if (activeController) activeController.abort();
      if (countdownTimer) window.clearInterval(countdownTimer);
      setAddToCartDisabled(false);
      buttonObserver.disconnect();
      eventController.abort();
    };
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target instanceof Element && event.target.contains(root)) cleanup();
    }, eventOptions);

    setSavedLocationActive(Boolean(savedPostal));
    updateCountryFlags();
    initPolicy().then(() => {
      if (
        root.dataset.autoCheckSavedAddress === 'true'
        && root.dataset.savedLocationActive === 'true'
        && pinInput.value === savedPostal
        && !root.hidden
      ) runCheck();
    });
  })();
</script>

{% endif %}

{% schema %}
{
  "name": "t:delivery_checker.schema.name",
  "target": "section",
  "enabled_on": {
    "templates": ["product", "collection", "index", "cart", "search", "blog", "article", "page", "list-collections", "404", "password"]
  },
  "settings": [
    {
