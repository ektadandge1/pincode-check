{% liquid
  assign block_id = block.id | replace: '-', ''
  assign heading_text = block.settings.heading | default: 'Check delivery to your area'
  assign button_text = block.settings.button_text | default: 'Check'
  assign cod_enabled = block.settings.cod_enabled
%}

<div class="pin-checker" id="pin-checker-{{ block_id }}" data-cod="{{ cod_enabled }}">
  <div class="pin-checker__top">
    <h3 class="pin-checker__heading">{{ heading_text }}</h3>
    <span class="pin-checker__badge">Fast ETA</span>
  </div>
  <p class="pin-checker__sub">Enter your pincode to check delivery availability and estimated date.</p>
  <div class="pin-checker__row">
    <input
      class="pin-checker__input"
      type="text"
      inputmode="numeric"
      maxlength="6"
      placeholder="Enter pincode"
      aria-label="Enter pincode"
      id="pin-input-{{ block_id }}"
    >
    <button class="pin-checker__button" type="button" id="pin-btn-{{ block_id }}">{{ button_text }}</button>
  </div>
  <div class="pin-checker__meta">
    <span class="pin-checker__meta-item">Secure checkout</span>
    <span class="pin-checker__meta-item">Trusted courier partners</span>
  </div>
  <p class="pin-checker__result" id="pin-result-{{ block_id }}" aria-live="polite"></p>
</div>

<style>
  #pin-checker-{{ block_id }} {
    --pc-bg-1: #f7fbff;
    --pc-bg-2: #f7faf7;
    --pc-border: #d8e2ec;
    --pc-heading: #102a43;
    --pc-sub: #486581;
    --pc-input-border: #bcccdc;
    --pc-focus: #0b6bcb;
    --pc-btn: #0b6bcb;
    --pc-btn-hover: #0857a8;
    --pc-meta-bg: #eef4fa;
    --pc-meta-text: #334e68;
  }
  .pin-checker {
    border: 1px solid var(--pc-border);
    border-radius: 14px;
    padding: 14px;
    background: linear-gradient(145deg, var(--pc-bg-1), var(--pc-bg-2));
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
  }
  .pin-checker__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .pin-checker__heading {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--pc-heading);
  }
  .pin-checker__badge {
    font-size: 11px;
    background: #e6eff8;
    color: #174f84;
    border: 1px solid #c6def6;
    border-radius: 999px;
    padding: 3px 8px;
    white-space: nowrap;
  }
  .pin-checker__sub {
    margin: 7px 0 10px;
    color: var(--pc-sub);
    font-size: 12px;
    line-height: 1.45;
  }
  .pin-checker__row {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }
  .pin-checker__input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--pc-input-border);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
    background: #ffffff;
    color: #1f2937;
  }
  .pin-checker__input:focus {
    outline: 2px solid color-mix(in srgb, var(--pc-focus) 25%, transparent);
    outline-offset: 1px;
    border-color: var(--pc-focus);
  }
  .pin-checker__button {
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 10px 16px;
    background: var(--pc-btn);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .pin-checker__button:hover {
    background: var(--pc-btn-hover);
  }
  .pin-checker__button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .pin-checker__meta {
    margin-top: 10px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pin-checker__meta-item {
    background: var(--pc-meta-bg);
    color: var(--pc-meta-text);
    border: 1px solid #d9e5f2;
    border-radius: 999px;
    font-size: 11px;
    padding: 4px 8px;
  }
  .pin-checker__result {
    margin: 10px 0 0;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: #f8fafc;
    font-size: 13px;
    color: #1f2937;
    min-height: 18px;
    display: none;
  }
  .pin-checker__result[data-state='loading'] {
    display: block;
    color: #1d4f91;
    background: #f0f7ff;
    border-color: #c9e0fb;
  }
  .pin-checker__result[data-state='error'] {
    display: block;
    color: #b91c1c;
    background: #fef2f2;
    border-color: #fecaca;
  }
  .pin-checker__result[data-state='success'] {
    display: block;
    color: #065f46;
    background: #ecfdf3;
    border-color: #a7f3d0;
  }
  @media (max-width: 640px) {
    .pin-checker__row {
      flex-direction: column;
    }
    .pin-checker__button {
      width: 100%;
    }
    .pin-checker__top {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('pin-checker-{{ block_id }}');
    if (!root) return;

    const pinInput = document.getElementById('pin-input-{{ block_id }}');
    const button = document.getElementById('pin-btn-{{ block_id }}');
    const result = document.getElementById('pin-result-{{ block_id }}');
    const cod = root.dataset.cod === 'true';

    const setResult = (message, state) => {
      result.textContent = message;
      result.setAttribute('data-state', state || '');
    };

    const validate = (pin) => /^[1-9][0-9]{5}$/.test(pin);

    const runCheck = async () => {
      const pin = (pinInput.value || '').replace(/\D/g, '').trim();
      pinInput.value = pin;

      if (!validate(pin)) {
        setResult('Please enter a valid 6-digit pincode.', 'error');
        return;
      }

      setResult('Checking delivery availability...', 'loading');
      button.disabled = true;

      try {
        const query = new URLSearchParams({
          pincode: pin,
          cod: cod ? '1' : '0'
        });

        const response = await fetch(`/apps/pincode-checker?${query.toString()}`, {
          method: 'GET',
          headers: { Accept: 'application/json' }
        });

        const data = await response.json();
        if (!response.ok) {
          setResult('Unable to check this pincode right now. Please retry.', 'error');
          return;
        }

        setResult(data.message || 'Unable to check this pincode right now.', data.available ? 'success' : 'error');
      } catch (error) {
        setResult('Network issue while checking pincode. Please retry.', 'error');
      } finally {
        button.disabled = false;
      }
    };

    button.addEventListener('click', runCheck);
    pinInput.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        runCheck();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Pincode checker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Check delivery to your area"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Check"
    },
    {
      "type": "checkbox",
      "id": "cod_enabled",
      "label": "Request COD availability",
      "default": true
    }
  ]
}
{% endschema %}
