{
  "name": "t:delivery_embed.schema.name",
  "target": "body",
  "settings": [
    { "type": "text", "id": "button_label", "label": "t:delivery_embed.schema.button_label" },
    { "type": "text", "id": "heading", "label": "t:delivery_embed.schema.heading_label" },
    { "type": "checkbox", "id": "auto_check_saved_address", "label": "t:delivery_embed.schema.auto_check_saved_address_label", "info": "t:delivery_embed.schema.auto_check_saved_address_info", "default": false },
    { "type": "checkbox", "id": "show_product_card_eta", "label": "t:delivery_embed.schema.show_product_card_eta_label", "info": "t:delivery_embed.schema.show_product_card_eta_info", "default": false },
    { "type": "color", "id": "accent_color", "label": "t:delivery_embed.schema.accent_color_label", "default": "#f47d32" },
    { "type": "color", "id": "text_color", "label": "t:delivery_embed.schema.text_color_label", "default": "#171a1d" },
    { "type": "color", "id": "card_color", "label": "t:delivery_embed.schema.card_color_label", "default": "#ffffff" }
  ]
}
