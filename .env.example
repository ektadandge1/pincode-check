# Development template only. Do not use these placeholders for production.
NODE_ENV="development"
APP_ENV="development"
DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY="your-shopify-client-id"
SHOPIFY_API_SECRET="your-shopify-client-secret"
SHOPIFY_APP_URL="https://your-production-domain.example"
SCOPES="read_products,read_inventory,read_locations,read_orders,read_themes,write_app_proxy"
SHOPIFY_APP_HANDLE="your-app-handle"
SHOPIFY_APP_GID="gid://shopify/App/123456789"
SHOPIFY_PARTNER_ORG_ID="1234567"
SHOPIFY_PARTNER_API_ACCESS_TOKEN="your-partner-api-access-token"
SHOPIFY_BILLING_REQUIRED="true"
SHOPIFY_BILLING_DEV_BYPASS="true"
SUPPORT_EMAIL="support@example.com"
LEGAL_BUSINESS_NAME="Your legal business name"

# Optional India courier integration.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
DEFAULT_PACKAGE_WEIGHT_KG="0.5"

# Configure Standard at $9 USD monthly with a 7-day trial in Shopify App
# Pricing. Development billing is bypassed by default; set
# SHOPIFY_BILLING_DEV_BYPASS=false to test Shopify's hosted pricing flow.
# Production requires NODE_ENV=production, APP_ENV=production,
# SHOPIFY_BILLING_REQUIRED=true and SHOPIFY_BILLING_DEV_BYPASS=false (or unset).
# Use an absolute SQLite file path
# on a persistent volume, for example file:/data/incode-track.sqlite.
# env:check validates production only; it does not verify volume durability.
