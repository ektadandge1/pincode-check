# Development template only. Do not use these placeholders for production.
NODE_ENV="development"
APP_ENV="development"
DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY="your-shopify-client-id"
SHOPIFY_API_SECRET="your-shopify-client-secret"
SHOPIFY_APP_URL="https://your-production-domain.example"
SCOPES="read_products,read_inventory,read_locations,read_orders,write_app_proxy"
SHOPIFY_APP_HANDLE="Pncode-track"
SHOPIFY_BILLING_TEST="true"
SHOPIFY_BILLING_REQUIRED="true"
SHOPIFY_BILLING_DEV_BYPASS="true"
SUPPORT_EMAIL="support@example.com"
LEGAL_BUSINESS_NAME="Your legal business name"

# Optional India courier integration.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
DEFAULT_PACKAGE_WEIGHT_KG="0.5"

# Keep SHOPIFY_BILLING_TEST=true for development stores. Set it to false only
# in production for a public or unlisted Shopify app. Development billing is
# bypassed by default; set SHOPIFY_BILLING_DEV_BYPASS=false to test billing.
# Production requires NODE_ENV=production, APP_ENV=production,
# SHOPIFY_BILLING_TEST=false, SHOPIFY_BILLING_REQUIRED=true and
# SHOPIFY_BILLING_DEV_BYPASS=false (or unset). Use an absolute SQLite file path
# on a persistent volume, for example file:/data/incode-track.sqlite.
# env:check validates production only; it does not verify volume durability.
