DATABASE_URL="file:./dev.sqlite"
SHOPIFY_API_KEY="your-shopify-client-id"
SHOPIFY_API_SECRET="your-shopify-client-secret"
SHOPIFY_APP_URL="https://your-production-domain.example"
SCOPES="read_inventory,read_locations,read_orders,read_products,read_shipping,write_app_proxy,write_orders"
SHOPIFY_APP_HANDLE="incode-track"
SHOPIFY_PARTNER_ORG_ID="your-partner-organization-id"
SHOPIFY_PARTNER_API_ACCESS_TOKEN="your-partner-api-client-token"
SHOPIFY_APP_GID="gid://shopify/App/your-numeric-app-id"
SHOPIFY_BASIC_PLAN_HANDLES="basic"
SHOPIFY_ADVANCED_PLAN_HANDLES="advanced"
SUPPORT_EMAIL="support@example.com"
LEGAL_BUSINESS_NAME="Your legal business name"

# Optional India courier integration.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_PINCODE=""
DEFAULT_PACKAGE_WEIGHT_KG="0.5"

# Local development only. Production always verifies Shopify subscription state.
BILLING_DEV_PLAN="advanced"
