// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PostalCode {
  id            Int      @id @default(autoincrement())
  shop          String   @default("default")
  country       String   @default("IN")
  postalCode    String
  city          String?
  state         String?
  zone          String?
  serviceable   Boolean  @default(true)
  deliveryDays  Int
  codAvailable  Boolean  @default(false)
  deliveryCharge Float?
  currency      String?
  sameDayAvailable Boolean @default(false)
  nextDayAvailable Boolean @default(false)
  expressAvailable Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, country, postalCode])
}

model DeliverySetting {
  id                Int      @id @default(autoincrement())
  shop              String   @unique @default("default")
  cutoffHour24      Int      @default(14)
  holidaysCsv       String   @default("")
  fallbackDays      Int      @default(5)
  weekendDaysCsv    String   @default("0")
  courierTimeoutMs  Int      @default(2000)
  retryCount        Int      @default(1)
  courierEnabled    Boolean  @default(false)
  dbFallbackEnabled Boolean  @default(true)
  inventoryAwareEnabled Boolean @default(false)
  disableAddToCart  Boolean  @default(false)
  successMessage    String   @default("Delivery by {date}. {cod_message}{delivery_charge_message}")
  unavailableMessage String  @default("Sorry, delivery is not available for this postal code.")
  codAvailableMessage String @default("COD available.")
  codUnavailableMessage String @default("Prepaid only.")
  deliveryChargeMessage String @default(" Delivery charge: {currency}{delivery_charge}.")
  googleSheetCsvUrl String?
  lastGoogleSheetSyncAt DateTime?
  lastGoogleSheetSyncStatus String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AppSubscription {
  id                Int      @id @default(autoincrement())
  shop              String   @unique
  plan              String
  shopifySubscriptionId String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ImportJob {
  id           Int      @id @default(autoincrement())
  shop         String
  source       String
  status       String
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorSummary String?
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}

model ImportError {
  id          Int      @id @default(autoincrement())
  importJobId Int
  rowNumber   Int
  rawRow      String
  reason      String
  createdAt   DateTime @default(now())

  @@index([importJobId])
}

model PostalCodeSearchEvent {
  id           Int      @id @default(autoincrement())
  shop         String
  country      String
  postalCode   String
  productId    String?
  variantId    String?
  city         String?
  state        String?
  available    Boolean
  codAvailable Boolean?
  deliveryDays Int?
  source       String
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, country, postalCode])
}
