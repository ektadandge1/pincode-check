# Read by systemd and Prisma. Keep this file to KEY=value lines.
NODE_ENV=production
APP_ENV=production
DATABASE_URL=file:/var/lib/incode-track/incode-track.sqlite

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://zippin.bmconsulting.in
SHOPIFY_APP_HANDLE=
SCOPES=read_products,read_inventory,read_locations,read_orders,write_app_proxy

SHOPIFY_BILLING_REQUIRED=true
SHOPIFY_BILLING_DEV_BYPASS=false
SUPPORT_EMAIL=
LEGAL_BUSINESS_NAME=

# Optional Shiprocket integration:
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
DEFAULT_PACKAGE_WEIGHT_KG=0.5
